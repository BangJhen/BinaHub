# ============================================================
# BinaHub AI Service - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# OpenAI (atau Azure OpenAI)
# Jika menggunakan OpenAI biasa:
OPENAI_API_KEY=sk-...

# Jika menggunakan Azure OpenAI (uncomment di bawah):
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-01

# Mode: "openai" atau "azure"
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Redis (opsional - jika tidak ada, cache dinonaktifkan)
REDIS_URL=redis://localhost:6379

# Security
AI_SERVICE_SECRET=binahub-ai-secret-key-change-in-production

# Environment
ENVIRONMENT=development

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
